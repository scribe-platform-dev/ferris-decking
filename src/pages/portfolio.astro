---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const rendered = await Promise.all(projects.map((p) => render(p)));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout
  title="Portfolio | Ferris Decking Co."
  description="Recent decks, restorations, and outdoor structures built by Ferris Decking Co. across Lititz, Manheim, Willow Street, and Lancaster, PA."
>
  <section class="wrap hero">
    <p class="eyebrow">Portfolio</p>
    <h1>A few of the yards we've worked in</h1>
    <p class="lede">Every project here has a story behind it — a tricky lot, a failing ledger board, a client who just wanted shade.</p>
  </section>

  <div class="wrap project-grid">
    {projects.map((p, i) => {
      const { Content } = rendered[i];
      return (
        <article class="project-card">
          <div class="plank-art" aria-hidden="true" data-variant={i % 3}></div>
          <div class="card-body">
            <span class="tag">{p.data.projectType}</span>
            <h2>{p.data.title}</h2>
            <p class="meta">{p.data.location}{p.data.size ? ` · ${p.data.size}` : ''}</p>
            <div class="summary"><Content /></div>
          </div>
        </article>
      );
    })}
  </div>

  <section class="wrap cta">
    <h2>Want yours on this page next?</h2>
    <a class="btn btn-primary" href={`${base}/contact/`}>Tell us about your yard</a>
  </section>
</Layout>

<style>
  .hero {
    padding-block: 4rem 2.5rem;
    max-width: 52ch;
  }
  .hero h1 {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    margin: 0.3em 0 0.4em;
  }
  .lede {
    color: var(--walnut-700);
    font-size: 1.05rem;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    padding-bottom: 4.5rem;
  }
  .project-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .plank-art {
    height: 140px;
  }
  .plank-art[data-variant='0'] {
    background: repeating-linear-gradient(100deg, var(--walnut-500) 0 26px, var(--walnut-700) 26px 52px);
  }
  .plank-art[data-variant='1'] {
    background: repeating-linear-gradient(100deg, var(--rust-600) 0 20px, var(--gold-400) 20px 24px, var(--walnut-700) 24px 48px);
  }
  .plank-art[data-variant='2'] {
    background: repeating-linear-gradient(100deg, var(--gold-400) 0 18px, var(--walnut-500) 18px 44px, var(--rust-700) 44px 48px);
  }
  .card-body {
    padding: 1.6rem;
  }
  .card-body h2 {
    font-size: 1.3rem;
    margin: 0.5em 0 0.2em;
  }
  .meta {
    color: var(--rust-700);
    font-weight: 600;
    font-size: 0.88rem;
    margin: 0 0 0.8em;
  }
  .summary :global(p) {
    color: var(--walnut-700);
    font-size: 0.95rem;
    margin: 0;
  }
  .cta {
    text-align: center;
    padding-block: 4.5rem;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 700px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
